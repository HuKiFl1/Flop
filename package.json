{
  "name": "flop-channel-reclaim",
  "version": "0.1.0",
  "description": "Deterministic escrow reclaim / liquidation rule for stale paid-compute payment channels. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "payment-channel",
    "escrow",
    "liquidation",
    "state-machine",
    "inference",
    "bigint"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "fast-check": "^4.11.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
